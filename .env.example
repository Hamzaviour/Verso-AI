DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Free: Groq key from console.groq.com (no card). Leave empty to use Vercel AI Gateway instead.
GROQ_API_KEY=
AI_GATEWAY_API_KEY=
VERSO_ANALYSIS_MODEL=openai/gpt-oss-120b
# Local embedding model (transformers.js), runs on your machine for free
VERSO_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
CRON_SECRET=
